# Nothing here is required. Every value has a working default.

# --- Claude Code transcripts (auto-detected) --------------------------------
# CLAUDE_CONFIG_DIR is usually already set by your shell. Only override these
# if your transcripts live somewhere unusual.
# CLAUDE_CODE_PROJECTS_DIR=/path/to/projects
# DEV_AI_USAGE_DEVELOPER_ID=you@example.com

# --- Cursor (auto-detected) -------------------------------------------------
# CURSOR_TRACKING_DB=$HOME/.cursor/ai-tracking/ai-code-tracking.db
# CURSOR_STATE_DB=$HOME/.config/Cursor/User/globalStorage/state.vscdb

# --- Analytics API (optional; needs an ORG ADMIN key, not a workspace key) --
# The one credential this tool takes, and it only ever reads: it fetches your
# org's own usage records. There is no ANTHROPIC_API_KEY here and nothing that
# would use one - this tool observes, it never asks a model anything.
# ANTHROPIC_ADMIN_KEY=sk-ant-admin01-...

# --- Storage ----------------------------------------------------------------
# DEV_AI_USAGE_DB=./data/usage.db
# DEV_AI_USAGE_SPOOL=./data/spool.jsonl

# --- Observability module (optional, on by default, no key needed) ----------
# Records every run to data/observability/events.jsonl. Local trail only; it
# reads nothing into the numbers.
# DEV_AI_USAGE_OBSERVABILITY=off
